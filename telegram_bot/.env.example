# ================================
# SERIYA BOT - Sozlamalar
# ================================

# ==== TELEGRAM ====
# @BotFather orqali olingan token
TELEGRAM_TOKEN=1234567890:AAAA-BBBBBBBBBBBBBBBBBBBBBBBBBB
# Chat ID (foydalanuvchi ID yoki kanal ID @username shaklida ham bo'lishi mumkin)
TELEGRAM_CHAT_ID=123456789

# ==== BINANCE ====
# Faqat public API kerak (read-only), API key kerak emas
# Agar rate limit muammosi bo'lsa - ixtiyoriy API key qo'shish mumkin
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ==== KUZATILADIGAN JUFTLIKLAR ====
# Vergul bilan ajratilgan. Format:
#   Kripto (Binance Futures): BASE/USDT yoki BASE/USDT:USDT
#     Masalan: BTC/USDT, ETH/USDT, SOL/USDT, PAXG/USDT (gold-backed)
#   Forex/Stocks (Yahoo Finance): oddiy ticker (slash'siz)
#     XAUUSD (gold), XAGUSD (silver), NVDA, TSLA, DXYZ (SpaceX proxy),
#     SPY, QQQ, ARKX, GOLD, OIL, SPX, NASDAQ, DXY, va h.k.
#
# Aralashtirish mumkin - bot avtomatik yo'naltiradi:
PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,XAUUSD,NVDA,TSLA,DXYZ

# ==== TIMEFRAMES ====
# Vergul bilan ajratilgan.
# Mavjud: 1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h, 6h, 8h, 12h, 1d
TIMEFRAMES=5m,15m

# ==== STRATEGIYA SOZLAMALARI ====
# Minimum ketma-ket svechalar soni (default: 3)
MIN_CANDLES=3

# TP1 dan keyin SL break-even'ga siljisinmi
ENABLE_BE=true

# Fibonacci darajalari
FIB_SL=0.0
FIB_TP1=1.618
FIB_TP2=2.618
FIB_TP3=3.618

# SL buffer foizda - wick urib ketmasligi uchun SL ni uzoqroqqa siljitish
# 0.01 = 0.01% (masalan SL 100 bo'lsa, SELL uchun 100.01 ga, BUY uchun 99.99 ga)
SL_BUFFER_PCT=0.01

# Partial close foizlari (jami 100 bo'lishi kerak)
TP1_PCT=50
TP2_PCT=25
TP3_PCT=25

# ==== RISK ====
# Har bir bitim uchun risk ($)
RISK_USD=10.0

# ==== TEXNIK ====
# Poll interval (soniya) — bot qancha tez-tez tekshirsin
POLL_INTERVAL_SECONDS=30

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Holatni saqlash fayli (JSON)
STATE_FILE=state.json

# ==== KUNLIK REPORT ====
# Vaqt zonasi (IANA format). Masalan:
#   Asia/Tashkent — Tashkent vaqti (UTC+5)
#   Europe/Moscow — Moskva vaqti (UTC+3)
#   UTC          — Universal vaqt
REPORT_TZ=Asia/Tashkent

# Soat (00-23), qaysi soatda report yuborilsin
REPORT_HOUR=0
