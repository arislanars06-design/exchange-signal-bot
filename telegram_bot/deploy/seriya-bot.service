[Unit]
Description=SERIYA Telegram Bot (Binance Futures Strategy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seriya
WorkingDirectory=/opt/seriya-bot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/seriya-bot/.env
ExecStart=/opt/seriya-bot/venv/bin/python /opt/seriya-bot/main.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=seriya-bot

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/seriya-bot

[Install]
WantedBy=multi-user.target
